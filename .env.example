# ============================================================
# Supabase — publieke keys (veilig in de browser via NEXT_PUBLIC_)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Supabase — geheime service-role key
# ALLEEN server-side; NOOIT als NEXT_PUBLIC_-prefix!
# Deze key omzeilt Row Level Security en mag uitsluitend in
# server-side API-routes gebruikt worden (widget-backend).
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# LLM-provider — ALLEEN server-side
# Leeg laten = mock-LLM (lokale ontwikkeling en CI zonder kosten).
# Key invullen = echte Anthropic-adapter (Claude Haiku 4.5), alleen
# lokaal en met verzonnen testdata: de directe API verwerkt buiten de EU.
# In productie mag deze key NIET bestaan; daar loopt de LLM via Bedrock.
# ============================================================
ANTHROPIC_API_KEY=

# Expliciete providerkeuze: mock (default) | bedrock | anthropic.
# Productie: bedrock, de enige waarde met EU-residentie.
# De keuze is expliciet: een ingevulde ANTHROPIC_API_KEY alleen activeert
# niets meer. In productie weigert de app elke andere waarde dan bedrock
# (residentie-slot). De enige uitweg is ALLOW_NON_EU_LLM=true. Gebruik alleen bewust.
#
# Lokaal testen met Bedrock: LLM_PROVIDER=bedrock, inloggen met
# "aws login --profile <naam>" en AWS_PROFILE=<naam> zetten. Alleen met
# verzonnen testdata.
LLM_PROVIDER=

# ============================================================
# Dagrem op AI-kosten, platformbreed over alle tenants.
# Geldt voor elke echte provider, niet voor de mock. Boven het plafond
# wordt die dag geen enkele LLM-aanroep meer gedaan; de intake rondt dan
# vriendelijk af. Waarschuwing in de logs op 50% en 80%.
#
# Bedragen in dollars. De tarieven zijn per miljoen tokens en horen bij het
# gekozen model, INCLUSIEF de 10% toeslag van het EU-profiel. Pas ze aan bij
# een modelwissel. Leeg = onderstaande waarden (Claude Haiku 4.5, EU).
# Haiku 5.5: Anthropic-lijstprijs plus EU-toeslag is 0.11 en 0.55 (stand
# 2026-11-23). Het Bedrock-tarief eerst bevestigen; met de 4.5-waarden is de
# rem bij 5.5 ongeveer tien keer te streng.
# Vereist migration 20261008000001_llm_kosten_dagrem.sql in de database.
# ============================================================
LLM_DAGPLAFOND_USD=5
LLM_PRIJS_INPUT_PER_MTOK=1.10
LLM_PRIJS_OUTPUT_PER_MTOK=5.50
# Dagrem per klant (zelfde eenheid). Eén bestookte klant legt zo niet de AI
# van alle klanten stil. Standaard 2 dollar; kies hem lager dan het plafond.
LLM_DAGPLAFOND_PER_KLANT_USD=2

# ============================================================
# AWS (Bedrock, SES). ALLEEN server-side.
# Eén account, één regio: eu-north-1 (Stockholm).
#
# AWS_REGION: in Vercel EXPLICIET zetten. Vercel vult deze variabele anders
# zelf met de uitvoeringsregio van de functie. De code accepteert alleen
# EU-regio's en valt zonder waarde terug op eu-north-1.
#
# AWS_ROLE_ARN: IAM-rol die Vercel via OIDC aanneemt (voorkeur: geen
# langlevende sleutel in Vercel). Alleen in Vercel Production; lokaal leeg,
# dan gebruikt de SDK je lokale AWS-profiel.
#
# AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY: alleen de terugvaloptie als
# OIDC niet lukt (aparte IAM-gebruiker, elke 90 dagen roteren). Altijd
# allebei of geen van beide. Staan hier bewust niet als lege regel.
#
# BEDROCK_MODEL_ID: moet een EU-inferentieprofiel zijn (begint met "eu.").
# Een "global."- of "us."-profiel verwerkt buiten de EU en wordt geweigerd.
# Nieuwer alternatief: eu.anthropic.claude-haiku-5-5. Pas wisselen na een
# groene ronde; dat model telt ongeveer 30%
# meer tokens voor dezelfde tekst, dus de tokenlimieten moeten dan mee.
# ============================================================
AWS_REGION=eu-north-1
AWS_ROLE_ARN=
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# ============================================================
# Widget-sessietokens (HS256) — ALLEEN server-side
# Minimaal 32 tekens random, bijv.:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Aparte waarde per omgeving (dev/prod).
# ============================================================
WIDGET_SESSION_SECRET=

# ============================================================
# Cloudflare Turnstile — botbescherming, feature-flag
# Beide leeg = uit (lokaal en CI). Beide ingevuld = botcheck verplicht
# vóór elke nieuwe widget-sessie.
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================
# E-mail
# Expliciete providerkeuze: mock (default) | ses.
# Leeg = mock: er gaan geen echte mails uit, alleen een logregel.
# Productie: ses in eu-north-1, afzender aanvragen@vakbalie.nl. De app
# weigert daar elke andere waarde (residentie-slot) en verstuurt dan niets.
# De enige uitweg is ALLOW_NON_EU_EMAIL=true; gebruik hoort in.
#
# SES gebruikt dezelfde AWS-variabelen als Bedrock (AWS_REGION, AWS_ROLE_ARN).
# Zolang SES in de sandbox zit, komt mail alleen aan op geverifieerde adressen.
# ============================================================
EMAIL_PROVIDER=

# Afzenderadres. Vereist bij ses.
EMAIL_FROM=

# In dev gaan ALLE mails hierheen (eigen testadres), nooit naar echte
# klanten. Mag in productie NIET bestaan: de app verstuurt dan niets.
EMAIL_CATCH_ALL=

# Optioneel: SES configuration set, om later bounce- en klachtevents aan
# te zetten zonder codewijziging. Leeg = geen.
SES_CONFIGURATION_SET=

# ============================================================
# Cookieloze bezoekersstatistieken (Plausible, EU). Optioneel.
# Bestandsnaam van het site-eigen script uit het Plausible-dashboard,
# bijv. pa-AbC123xyz.js. Leeg = geen analytics. Zie src/lib/analytics.ts.
# Zet je dit aan: vermeld Plausible in de privacyverklaring.
# ============================================================
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=

# Basis-URL van de app (voor links in mails), bijv. https://offerte-agent.vercel.app
NEXT_PUBLIC_APP_URL=

# ============================================================
# Live-demo op de etalagesite (/demo) — widget-key van de demo-tenant.
# Publiek (een widget-key is per ontwerp openbaar). Leeg = de /demo-pagina
# toont een nette "binnenkort"-fallback i.p.v. de widget.
# Demo-sessies draaien ALTIJD op de mock-LLM (nul tokens), ook met een echte
# ANTHROPIC_API_KEY. Lokaal komt deze key uit supabase/seed.sql.
# ============================================================
NEXT_PUBLIC_DEMO_TENANT_KEY=wk_demo_0000000000000001

# ============================================================
# Bewaartermijn-cron (AVG) — ALLEEN server-side
# Vercel stuurt dit secret automatisch mee als Authorization-header
# zodra de env var bestaat. Minimaal 16 tekens random; leeg = job uit.
# ============================================================
CRON_SECRET=
