# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Dependencies ---
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build output ---
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# --- Testing ---
/coverage
# Rapporten van `pnpm rooktest:llm` (modeluitvoer, alleen verzonnen data)
/rooktest-resultaten

# --- Environment variables ---
# Alles met secrets blijft buiten git. Alleen .env.example wordt gecommit.
.env
.env.*
!.env.example

# --- Supabase ---
supabase/.temp/
supabase/.branches/

# --- Vercel ---
.vercel

# --- Secrets / keys ---
*.pem

# --- Logs & debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
